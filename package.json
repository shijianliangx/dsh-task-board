{
  "name": "@local/dsh-task-board",
  "version": "1.2.1",
  "private": true,
  "description": "After a task is dispatched, the agent auto-generates a processing checklist and a delivery checklist from the requirement, then tracks progress, results and artifacts in a sidebar panel.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "preview.html"
  ],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "cordis", "task-board", "checklist", "progress"],
  "license": "MIT",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
